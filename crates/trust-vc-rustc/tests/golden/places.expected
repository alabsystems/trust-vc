exit: 0
outcome: "checked"
diagnostics:
functions:
  second_of verified -
  halve verified -
  make verified -
  set_first verified -
vcir:
Struct Pair Pair { first: u32, second: bool }
spec fn test_crate::second_of(p: spec Pair) -> result: spec bool
  = p.0:1
exec fn test_crate::halve(y: exec &mut u32) -> result: exec ()
  ensures ((*y) == (((old((*y)) as= int) / (2u32 as= int)) as u32))
  (*y) := ((*y) /[#1] 2u32)
  return[#2]
exec fn test_crate::make() -> p: exec Pair
  ensures test_crate::second_of(p)
  return[#1] Pair#0{7u32, true}
exec fn test_crate::set_first(mut p: exec Pair) -> result: exec ()
  p.0:0 := 100u32
  ghost {
    {
      assert[#1] ((p.0:0 as= int) == (100nat as= int))
    }
  }
  return[#2]
